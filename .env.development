# Local development: the site talks to the Firebase emulators (npm run emulators).
# Production values come from Firebase App Hosting (see apphosting.yaml).
GCLOUD_PROJECT=demo-portfolio
FIREBASE_STORAGE_BUCKET=demo-portfolio.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Skip the Google Cloud metadata-server lookup (there is none on this machine)
METADATA_SERVER_DETECTION=none
