{
  "name": "farid-bettioui-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Farid Bettioui portfolio — Next.js site + FireCMS admin on Firebase",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run admin:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm --prefix admin run typecheck",
    "admin:install": "npm --prefix admin install",
    "admin:build": "npm --prefix admin ci && npm --prefix admin run build",
    "emulators": "firebase emulators:start --only auth,firestore,storage --import=$HOME/.local/share/farid-portfolio/emulator --export-on-exit",
    "seed": "tsx seed/seed.ts",
    "test": "playwright test",
    "admin:build:local": "npm --prefix admin run build:local"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "next": "^16.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "firebase-tools": "^15.34.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
