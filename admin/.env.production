# Web config of the Firebase project (Firebase console → Project settings → Your apps → Web app).
# These values are public by design; access is enforced by Firestore/Storage rules and Auth.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_APP_ID=REPLACE_ME
