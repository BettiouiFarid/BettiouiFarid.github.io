{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "portfolio",
      "rootDir": "/",
      "ignore": ["node_modules", "admin/node_modules", ".git", ".next", "test-results", "playwright-report", "firebase-debug.log"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099, "host": "127.0.0.1" },
    "firestore": { "port": 8080, "host": "127.0.0.1" },
    "storage": { "port": 9199, "host": "127.0.0.1" },
    "ui": { "enabled": true, "port": 4000, "host": "127.0.0.1" },
    "singleProjectMode": true
  }
}
